POSTGRES_DB=db
POSTGRES_USER=user
POSTGRES_PASSWORD=password_here

DATABASE_URL=postgresql+psycopg2://user:password_here@localhost:5432/db

JWT_SECRET=<długi losowy napis>

ADMIN_NAME=ADMIN_NAME
ADMIN_EMAIL=ADMIN_EMAIL
ADMIN_PASSWORD=ADMIN_PASSWORD

# Symulator: kanały w formacie kod:sekret (te same kody i sekrety ustaw w POST /channels)
SIMULATOR_CHANNELS=sklep-a:sekret_kanalu_a,sklep-b:sekret_kanalu_b
# SKU produktów, które istnieją w systemie
SIMULATOR_SKUS=KUB-001,TSH-001
SIMULATOR_INTERVAL=10
